# ── LLM Provider ─────────────────────────────────────
# Options: "gemini", "openai", "groq"
LLM_PROVIDER=gemini

# Google Gemini (FREE — recommended for hackathon)
# Get key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# OpenAI (paid)
# OPENAI_API_KEY=your_openai_key
# OPENAI_MODEL=gpt-4.1-mini

# Groq (FREE — alternative)
# Get key at: https://console.groq.com/keys
# GROQ_API_KEY=your_groq_key
# GROQ_MODEL=llama-3.3-70b-versatile

# ── Neo4j Graph Database ────────────────────────────
# Neo4j AuraDB Free Tier (recommended):
# Sign up at: https://neo4j.com/cloud/aura-free/
NEO4J_URI=neo4j+s://your-auradb-id.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# Local Neo4j (alternative):
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password

# ── Threat Intelligence (optional) ──────────────────
# VirusTotal: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# AbuseIPDB: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# ── App Settings ────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
CORS_ORIGINS=*
